{
  "lsp": {
    "sourcekit-lsp": {
      "binary": {
        "path": "/usr/bin/sourcekit-lsp",
        "arguments": ["--default-workspace-type", "buildServer"],
      },
    },
  },
  "languages": {
    "Swift": {
      "enable_language_server": true,
      "language_servers": ["sourcekit-lsp"],
      "formatter": "language_server",
      "format_on_save": "on",
    },
  },
}
